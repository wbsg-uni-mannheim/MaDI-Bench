{
  "attribute_rules": {
    "artist": {
      "kwargs": {},
      "resolver": "most_complete"
    },
    "duration": {
      "kwargs": {},
      "resolver": "maximum"
    },
    "genre": {
      "kwargs": {},
      "resolver": "most_complete"
    },
    "label": {
      "kwargs": {},
      "resolver": "most_complete"
    },
    "name": {
      "kwargs": {},
      "resolver": "longest_string"
    },
    "release-country": {
      "kwargs": {},
      "resolver": "most_complete"
    },
    "release-date": {
      "kwargs": {},
      "resolver": "earliest"
    },
    "tracks": {
      "kwargs": {
        "separator": ","
      },
      "resolver": "union"
    }
  }
}