          "source_based_fact_coverage": "mean(1 - coverage.source_based.GR.same_source_collision_rate.pipe, 1 - coverage.source_based.GR.source_mix_distribution_js, 1 - mean(coverage.source_based.GR.source_attribution_js_per_attribute))",
