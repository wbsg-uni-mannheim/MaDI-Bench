    },
    "do": {
      "kwargs": {},
      "resolver": "voting"
    },
    "first_page": {
      "kwargs": {},
      "resolver": "voting"
    },
    "issue": {
      "kwargs": {},
      "resolver": "voting"
    },
    "journal": {
      "kwargs": {},
      "resolver": "most_complete"
    },
    "keywords": {
      "kwargs": {
        "separator": ","
      },
      "resolver": "union"
    },
    "kwd": {
      "kwargs": {
        "separator": ","
      },
      "resolver": "union"
    },
    "kwds": {
      "kwargs": {
        "separator": ","
      },
      "resolver": "union"
    },
    "last_page": {
      "kwargs": {},
      "resolver": "voting"
    },
    "pbl": {
      "kwargs": {},
