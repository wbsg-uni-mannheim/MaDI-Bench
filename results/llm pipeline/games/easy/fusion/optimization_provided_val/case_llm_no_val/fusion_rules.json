    },
    "platform": {
      "kwargs": {},
      "resolver": "union"
    },
    "publisher": {
      "kwargs": {},
      "resolver": "union"
    },
    "releaseYear": {
      "kwargs": {},
      "resolver": "earliest"
    },
    "series": {
      "kwargs": {},
      "resolver": "union"
    },
    "userScore": {
      "kwargs": {},
      "resolver": "median"
    }
  }
