{
  "attribute_rules": {
    "ESRB": {
      "kwargs": {},
      "resolver": "voting"
    },
    "criticScore": {
      "kwargs": {},
      "resolver": "median"
    },
    "developer": {
      "kwargs": {},
      "resolver": "union"
    },
    "genres": {
      "kwargs": {},
      "resolver": "union"
    },
    "globalSales": {
      "kwargs": {},
